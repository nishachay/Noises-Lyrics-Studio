# Noises Lyrics Studio — environment
# Copy this file to `.env` and fill in what you need. Everything except PORT is
# optional: leave a value blank to disable that feature. Never commit your `.env`.

# ─────────────────────────────────────────────────────────────
# Required
# ─────────────────────────────────────────────────────────────
# Port the local web server listens on.
PORT=3000

# ─────────────────────────────────────────────────────────────
# Optional — audio download (yt-dlp)
# ─────────────────────────────────────────────────────────────
# Path to a system-installed yt-dlp binary. Leave blank to use `yt-dlp` on PATH.
YTDLP_PATH=
# Path to a Netscape-format cookies.txt, for age- or region-locked videos.
YTDLP_COOKIES=

# ─────────────────────────────────────────────────────────────
# Optional — YouTube upload (bring your own Google OAuth client)
# ─────────────────────────────────────────────────────────────
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Defaults to http://localhost:3000/api/youtube-callback
YOUTUBE_REDIRECT_URI=

# ─────────────────────────────────────────────────────────────
# Optional — publishing / branding
# ─────────────────────────────────────────────────────────────
# Publish time used by the scheduler, 24h clock (e.g. 18:00).
UPLOAD_TIME_IST=
# Extra text appended to generated descriptions (e.g. "Follow me:\n- YouTube: ...").
SOCIAL_LINKS=

# ─────────────────────────────────────────────────────────────
# Optional — cloud render (GitHub Actions only; set these as repo Secrets)
# ─────────────────────────────────────────────────────────────
# Refresh token produced once via the local OAuth flow, used for non-interactive upload.
YOUTUBE_REFRESH_TOKEN=
# Friendly name for the channel the refresh token belongs to.
YOUTUBE_CHANNEL_NAME=

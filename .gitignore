# Dependencies
node_modules/

# Secrets & environment
.env
.env.*
!.env.example
cookies*
*cookies*.txt
*client_secret*
github_token.txt
youtube_auth.json
youtube_client_secret.json

# Runtime state (tokens, schedules, quota, competitor list, todos)
tokens/
.data/

# Generated output, renders, temp and thumbnails
output/
temp/
temp_unzip/
backup_zip/
thumbnails/
*.zip

# Bundled yt-dlp binaries (the app uses a system-installed yt-dlp)
bin/yt-dlp
bin/yt-dlp.exe
bin/yt-dlp.exe.old

# Media — never commit audio or video
*.mp3
*.wav
*.m4a
*.flac
*.aac
*.ogg
*.mp4
*.webm
*.mov
*.mkv

# Images (keep the app logos and allow docs screenshots/GIFs)
*.png
*.jpg
*.jpeg
!.gitattributes
!public/logo.png
!public/logo_white.png
!docs/*.png
!docs/*.jpg
!docs/*.jpeg
!docs/*.gif

# Local scratch / one-off files
scratch/
.agents/
beautiful-lyrics-ref/
public/app.backup.js
old_style.css
test_saavn.json
test_*.js
measure*.js
verify_font.js
fix_slashes.js
